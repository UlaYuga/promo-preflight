ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CORE=
ANTHROPIC_MODEL_FAST=
ANTHROPIC_MODEL_AUDIT=
DATABASE_URL=
# Public origin for absolute links in notifications (Telegram run alerts).
# Set in production, e.g. https://promo-preflight-production.up.railway.app
PUBLIC_APP_URL=
USE_MOCK_AI=true
MAX_INPUT_CHARS=50000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20
STORE_RAW_INPUT=false
RAW_INPUT_TTL_HOURS=24
NEXT_PUBLIC_APP_ENV=local
