ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CORE=
ANTHROPIC_MODEL_FAST=
ANTHROPIC_MODEL_AUDIT=
DATABASE_URL=
# Required to call /api/v1/*; leave unset only when the protected API should reject all callers.
PREFLIGHT_API_KEY=
# Public origin for absolute links in notifications (Telegram run alerts).
# Set in production, e.g. https://promo-preflight-production.up.railway.app
PUBLIC_APP_URL=
USE_MOCK_AI=true
MAX_INPUT_CHARS=50000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20
STORE_RAW_INPUT=false
RAW_INPUT_TTL_HOURS=24
NEXT_PUBLIC_APP_ENV=local
# Optional — Telegram run alerts. Unset = adapter is a no-op (see ADR-0004).
# Bot token from @BotFather; chat id from getUpdates (negative for channels).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OUTBOX_POLL_INTERVAL_MS=1000
